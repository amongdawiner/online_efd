{
    "name": "ubitechsolutionsltd/online-efd",
    "description": "Reusable Laravel package for TRA (Tanzania) VFD/EFD integration: per-tenant certificates & credentials, registration, receipts and Z-reports. Plain PHP/JSON API, no UI.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "tra", "vfd", "efd", "tanzania", "fiscal"],
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "OnlineEfd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OnlineEfd\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OnlineEfd\\EfdServiceProvider"
            ],
            "aliases": {
                "Efd": "OnlineEfd\\Facades\\Efd"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
